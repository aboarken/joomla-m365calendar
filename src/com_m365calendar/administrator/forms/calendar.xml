<?xml version="1.0" encoding="UTF-8"?>
<form addruleprefix="Joomla\Component\M365calendar\Administrator\Rule">
    <fieldset name="details" label="COM_M365CALENDAR_CALENDAR_FIELDSET_DETAILS">
        <field name="id" type="hidden" default="0" filter="integer" readonly="true" />
        <field
            name="title"
            type="text"
            label="JGLOBAL_TITLE"
            required="true"
            maxlength="255"
            filter="string"
        />
        <field
            name="mailbox"
            type="email"
            label="COM_M365CALENDAR_CALENDAR_MAILBOX_LABEL"
            description="COM_M365CALENDAR_CALENDAR_MAILBOX_DESC"
            required="true"
            maxlength="320"
            validate="email"
            filter="string"
            autocomplete="off"
        />
        <field
            name="graph_calendar_id"
            type="text"
            label="COM_M365CALENDAR_CALENDAR_CALENDAR_ID_LABEL"
            description="COM_M365CALENDAR_CALENDAR_CALENDAR_ID_DESC"
            maxlength="512"
            filter="string"
            validate="M365calendarid"
            message="COM_M365CALENDAR_CALENDAR_ERROR_CALENDAR_ID"
            autocomplete="off"
        />
        <field
            name="color"
            type="color"
            label="COM_M365CALENDAR_CALENDAR_COLOR_LABEL"
            description="COM_M365CALENDAR_CALENDAR_COLOR_DESC"
            default="#0d6efd"
            validate="color"
        />
        <field
            name="allow_feeds"
            type="radio"
            label="COM_M365CALENDAR_CALENDAR_ALLOW_FEEDS_LABEL"
            description="COM_M365CALENDAR_CALENDAR_ALLOW_FEEDS_DESC"
            layout="joomla.form.field.radio.switcher"
            default="0"
            filter="integer"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>
    <fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING">
        <field
            name="published"
            type="list"
            label="JSTATUS"
            default="1"
            class="form-select-color-state"
            validate="options"
            filter="integer"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
        <field
            name="access"
            type="accesslevel"
            label="JFIELD_ACCESS_LABEL"
            filter="UINT"
            validate="options"
        />
        <field name="ordering" type="hidden" filter="integer" />
        <field name="created" type="calendar" label="JGLOBAL_FIELD_CREATED_LABEL" translateformat="true" showtime="true" filter="user_utc" readonly="true" />
        <field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" translateformat="true" showtime="true" filter="user_utc" readonly="true" />
        <field name="checked_out" type="hidden" filter="unset" />
        <field name="checked_out_time" type="hidden" filter="unset" />
    </fieldset>
</form>
