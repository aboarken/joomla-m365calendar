<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Joomla\Component\M365calendar\Administrator\Field">
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_M365CALENDAR_FILTER_SEARCH_LABEL"
            description="COM_M365CALENDAR_EVENTS_FILTER_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />
        <field
            name="calendar_id"
            type="M365calendars"
            label="COM_M365CALENDAR_FILTER_CALENDAR_LABEL"
            onchange="this.form.submit();"
        >
            <option value="">COM_M365CALENDAR_FILTER_SELECT_CALENDAR</option>
        </field>
        <field
            name="category"
            type="M365categories"
            label="COM_M365CALENDAR_FILTER_CATEGORY_LABEL"
            onchange="this.form.submit();"
        >
            <option value="">COM_M365CALENDAR_FILTER_SELECT_CATEGORY</option>
        </field>
        <field
            name="time"
            type="list"
            label="COM_M365CALENDAR_FILTER_TIME_LABEL"
            onchange="this.form.submit();"
        >
            <option value="">COM_M365CALENDAR_FILTER_SELECT_TIME</option>
            <option value="upcoming">COM_M365CALENDAR_TIME_UPCOMING</option>
            <option value="past">COM_M365CALENDAR_TIME_PAST</option>
        </field>
        <field
            name="all_day"
            type="list"
            label="COM_M365CALENDAR_FILTER_TYPE_LABEL"
            onchange="this.form.submit();"
        >
            <option value="">COM_M365CALENDAR_FILTER_SELECT_TYPE</option>
            <option value="1">COM_M365CALENDAR_TYPE_ALLDAY</option>
            <option value="0">COM_M365CALENDAR_TYPE_TIMED</option>
        </field>
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="e.start_utc ASC"
            onchange="this.form.submit();"
            validate="options"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="e.start_utc ASC">COM_M365CALENDAR_SORT_START_ASC</option>
            <option value="e.start_utc DESC">COM_M365CALENDAR_SORT_START_DESC</option>
            <option value="e.subject ASC">COM_M365CALENDAR_SORT_SUBJECT_ASC</option>
            <option value="e.subject DESC">COM_M365CALENDAR_SORT_SUBJECT_DESC</option>
            <option value="c.title ASC">COM_M365CALENDAR_SORT_CALENDAR_ASC</option>
            <option value="c.title DESC">COM_M365CALENDAR_SORT_CALENDAR_DESC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="25"
            onchange="this.form.submit();"
        />
    </fields>
</form>
