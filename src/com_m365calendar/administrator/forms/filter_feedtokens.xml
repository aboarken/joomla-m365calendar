<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_M365CALENDAR_FILTER_SEARCH_LABEL"
            description="COM_M365CALENDAR_FEEDTOKENS_FILTER_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="t.created DESC"
            onchange="this.form.submit();"
            validate="options"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="u.name ASC">COM_M365CALENDAR_SORT_NAME_ASC</option>
            <option value="u.name DESC">COM_M365CALENDAR_SORT_NAME_DESC</option>
            <option value="t.created ASC">COM_M365CALENDAR_SORT_CREATED_ASC</option>
            <option value="t.created DESC">COM_M365CALENDAR_SORT_CREATED_DESC</option>
            <option value="t.last_used ASC">COM_M365CALENDAR_SORT_LAST_USED_ASC</option>
            <option value="t.last_used DESC">COM_M365CALENDAR_SORT_LAST_USED_DESC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="25"
            onchange="this.form.submit();"
        />
    </fields>
</form>
