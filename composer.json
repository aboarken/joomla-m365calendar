{
    "name": "aboarken/joomla-m365calendar",
    "description": "Development tools for pkg_m365calendar (not shipped with the extension).",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "joomla/database": "^3.0",
        "joomla/registry": "^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "M365Graph\\": "src/lib_m365graph/src/",
            "Joomla\\Component\\M365calendar\\Administrator\\": "src/com_m365calendar/administrator/src/",
            "Joomla\\Component\\M365calendar\\Site\\": "src/com_m365calendar/site/src/",
            "Joomla\\Plugin\\Task\\M365calendarsync\\": "src/plg_task_m365calendarsync/src/",
            "M365Calendar\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "stan": "phpstan analyse --memory-limit=1G",
        "build": "php build/build.php"
    }
}
