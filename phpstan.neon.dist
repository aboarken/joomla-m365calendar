# PHPStan (level 6). The extension code extends Joomla core classes, so
# PHPStan needs a Joomla 5 (or 6) installation or release package to read them:
#
#   JOOMLA_ROOT=/path/to/joomla vendor/bin/phpstan analyse
#
# CI runs it against the Joomla 5 and 6 releases named in .github/workflows/tests.yml.
parameters:
    level: 6
    phpVersion: 80100
    paths:
        - src/lib_m365graph/src
        - src/com_m365calendar/administrator/src
        - src/com_m365calendar/site/src
        - src/plg_task_m365calendarsync/src
        - src/com_m365calendar/administrator/services/provider.php
        - src/plg_task_m365calendarsync/services/provider.php
        - src/pkg/script.php
        - tests/Unit
        - tests/Support
    scanDirectories:
        - %env.JOOMLA_ROOT%/libraries/src
        - %env.JOOMLA_ROOT%/libraries/vendor
        - %env.JOOMLA_ROOT%/administrator/components/com_scheduler/src
        - %env.JOOMLA_ROOT%/administrator/components/com_actionlogs/src
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    # Set by Joomla at runtime; the bootstrap only gives it a placeholder value.
    dynamicConstantNames:
        - JVERSION
    ignoreErrors:
        # Joomla types Factory::getApplication() and controllers' $this->app as the
        # generic CMSApplicationInterface. On the site (and in the backend for
        # getUserState) the object is a SiteApplication / AdministratorApplication,
        # which has these methods; core Joomla code calls them the same way.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Joomla\\CMS\\Application\\CMSApplicationInterface::(getMenu|getParams|getSession|getPathway|getUserState|setUserState|getUserStateFromRequest|setHeader|sendHeaders)\(\)\.$#'
        # HtmlView::getDocument() is typed as Document, but HTML views always get an
        # HtmlDocument, which has these methods (core views use them the same way).
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Joomla\\CMS\\Document\\Document::(getToolbar|addHeadLink)\(\)\.$#'
        # AdminModel requires getForm(); Joomla's own convention for "no form" is
        # returning false. This model is only used to delete (revoke) tokens.
        -
            identifier: method.childReturnType
            path: src/com_m365calendar/administrator/src/Model/FeedtokenModel.php
        # The task plugin's provider picks the constructor call at runtime. The
        # config-only call is for Joomla 6+, where CMSPlugin::__construct($config);
        # analysed against Joomla 5 that branch looks wrong, against 6 it does not.
        -
            identifier: argument.type
            message: '#^Parameter \#1 \$dispatcher of class Joomla\\Plugin\\Task\\M365calendarsync\\Extension\\M365calendarsync constructor expects Joomla\\Event\\DispatcherInterface, array<mixed, mixed> given\.$#'
            path: src/plg_task_m365calendarsync/services/provider.php
            reportUnmatched: false
